# Base de données locale (docker compose up -d)
DATABASE_URL=postgres://phronesis:phronesis@localhost:5433/phronesis

# Clerk (auth) — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Résumés IA (batch) — provider configurable : "mistral" ou "openai"
AI_PROVIDER=mistral
AI_MODEL=mistral-small-latest
# MISTRAL_API_KEY=
# OPENAI_API_KEY=
