# Base de données
# Dev local : postgres://phronesis:phronesis@localhost:5433/phronesis
# Batch prod : URL Neon DIRECTE (sans -pooler)
# Vercel prod : URL Neon POOLER (-pooler dans le hostname)
DATABASE_URL=

# Clerk (auth) — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Secret de signature du webhook Clerk (user.deleted → effacement des données)
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Résumés IA (batch) — provider configurable : "mistral" ou "openai"
AI_PROVIDER=mistral
AI_MODEL=mistral-large-4
# MISTRAL_API_KEY=
# OPENAI_API_KEY=

# Vidage du cache des pages (POST /api/revalidate) — même valeur sur Vercel et en secret GitHub
REVALIDATE_SECRET=

# Référencement
# URL publique canonique (sans / final). Par défaut : domaine de production Vercel.
# NEXT_PUBLIC_SITE_URL=https://www.exemple.fr
# Codes de vérification Google Search Console / Bing Webmaster Tools (balise meta)
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
